// 9. اختيار اللون
// ============================================
function selectColor(colorKey) {
    if (colorKey === currentColorKey) return;
    currentColorKey = colorKey;
    currentImages = colorSets[colorKey].images;
    currentIndex = 0;
    
    const img = document.getElementById('mainImage');
    img.style.transition = 'none';
    img.style.opacity = '0';
    setTimeout(() => {
        img.src = currentImages[currentIndex];
        img.style.transition = 'opacity 0.4s ease';
        img.style.opacity = '1';
    }, 50);
    
    // تحديث الصور المصغرة
    document.querySelectorAll('.thumb').forEach((t, i) => {
        t.classList.remove('active');
        if (i === Object.keys(colorSets).indexOf(colorKey)) {
            t.classList.add('active');
        }
    });
    
    // تحديث الألوان
    document.querySelectorAll('.swatch').forEach(s => s.classList.remove('active'));
    const swatchIndex = ['beige', 'green', 'grey'].indexOf(colorKey);
    document.querySelectorAll('.swatch')[swatchIndex].classList.add('active');
    document.getElementById('color-name-display').innerText = 'اللون: ' + colorSets[colorKey].name;
}

