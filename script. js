// 7. دالة قلب البطاقة (Card Flip) مع نصوص تسويقية
// ============================================
function flipCard() {
    if (isAnimating) return;
    isAnimating = true;
    
    const container = document.getElementById('imageContainer');
    const textElement = document.getElementById('marketingText');
    
    // اختيار نص تسويقي عشوائي
    const randomText = marketingTexts[Math.floor(Math.random() * marketingTexts.length)];
    textElement.innerText = randomText;
    
    // قلب البطاقة
    container.classList.toggle('flipped');
    isFlipped = !isFlipped;
    
    setTimeout(() => {
        isAnimating = false;
    }, 600);
}

// ============================================
// 8. التنقل بين الصور (أنيميشن 0.5 ثانية)
// ============================================
function navigateImage(direction) {
    if (isAnimating) return;
    if (isFlipped) {
        // إعادة البطاقة لوضعها الطبيعي قبل التنقل
        document.getElementById('imageContainer').classList.remove('flipped');
        isFlipped = false;
        setTimeout(() => navigateImage(direction), 300);
        return;
    }
    
    isAnimating = true;
    const img = document.getElementById('mainImage');
    currentIndex = (currentIndex + direction + currentImages.length) % currentImages.length;
    
    img.style.transition = 'transform 0.5s ease, opacity 0.5s ease';
    
    if (direction === 1) {
        img.style.transform = 'translateX(-60px) scale(0.9)';
        img.style.opacity = '0';
        setTimeout(() => {
            img.src = currentImages[currentIndex];
            img.style.transition = 'none';
            img.style.transform = 'translateX(60px) scale(0.9)';
            img.style.opacity = '0';
            setTimeout(() => {
                img.style.transition = 'transform 0.5s ease, opacity 0.5s ease';
                img.style.transform = 'translateX(0) scale(1)';
                img.style.opacity = '1';
                isAnimating = false;
            }, 20);
        }, 500);
    } else {
        img.style.transform = 'translateX(60px) scale(0.9)';
        img.style.opacity = '0';
        setTimeout(() => {
            img.src = currentImages[currentIndex];
            img.style.transition = 'none';
            img.style.transform = 'translateX(-60px) scale(0.9)';
            img.style.opacity = '0';
            setTimeout(() => {
                img.style.transition = 'transform 0.5s ease, opacity 0.5s ease';
                img.style.transform = 'translateX(0) scale(1)';
                img.style.opacity = '1';
                isAnimating = false;
            }, 20);
        }, 500);
    }
}

