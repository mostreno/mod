let exitPopupShown = false;

document.addEventListener('mouseleave', (e) => {
    if (e.clientY < 0 && !exitPopupShown) {
        exitPopupShown = true;
        const popup = document.createElement('div');
        popup.className = 'exit-popup';
        popup.innerHTML = `
            <h3>🎁 انتظر! لا تفوت العرض!</h3>
            <p>خصم 200ج على كل قطعتين + شحن مجاني للطلبات فوق 500ج</p>
            <button onclick="this.parentElement.remove()">🛒 استمر في التسوق</button>
            <button onclick="window.location.href='#checkout-page'" style="background: #e74c3c; color: white;">
                ✅ أطلب الآن
            </button>
        `;
        document.body.appendChild(popup);
        
        setTimeout(() => {
            if (popup.parentElement) popup.remove();
        }, 10000);
    }
});

